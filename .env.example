# Node 24+. Local-only development requires no credentials.
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/vault-terminal.sqlite
# Comma-separated allowed web origins. Include https://localhost for Android.
WEB_ORIGIN=http://localhost:5173
# For a deployment: AUTH_REQUIRED=true, NODE_ENV=production, HTTPS reverse proxy.
AUTH_REQUIRED=false
# Only for the separately launched desktop agent. Never prefix secrets with VITE_.
SERVER_URL=http://127.0.0.1:8787
VAULT_PATH=
DEVICE_TOKEN=
DESKTOP_DEVICE_ID=3b4302aa-cd1a-4bb9-844c-9078e24d05cc
