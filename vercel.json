{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run db:migrate:vault-mirror && npm run build",
  "outputDirectory": "dist/web",
  "functions": {
    "api/[...path].ts": { "includeFiles": "dist/vercel.mjs" }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...path].ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
